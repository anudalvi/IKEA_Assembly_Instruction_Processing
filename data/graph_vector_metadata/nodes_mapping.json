{
   "_comment":"Configuration file to drive the transformation for extraction of data for different nodes.",
   "extraction_pipeline":[
      {
         "node_key":"product_details_node",
         "strategy_type":"single_record",
         "primary_source_key":"PDF File Details",
         "primary_source":"pdf_file_details",
         "primary_filter":{
            "field":"pdf_type",
            "ops":"contains",
            "value":"Assembly"
         },
         "fields":[
            {
               "target_column":"product_name",
               "source":"pdf_file_details",
               "source_column":"product_name",
               "transform":[
                  {
                     "name":"split_str",
                     "args":{
                        "delimiter":",",
                        "index":0
                     }
                  },
                  {
                     "name":"strip_str"
                  }
               ]
            },
            {
               "target_column":"product_color",
               "source":"pdf_file_details",
               "source_column":"product_name",
               "transform":[
                  {
                     "name":"split_str",
                     "args":{
                        "delimiter":",",
                        "index":1
                     }
                  },
                  {
                     "name":"strip_str"
                  }
               ]
            },
            {
               "target_column":"product_dimension",
               "source":"pdf_file_details",
               "source_column":"product_name",
               "transform":[
                  {
                     "name":"split_str",
                     "args":{
                        "delimiter":",",
                        "index":2
                     }
                  },
                  {
                     "name":"strip_str"
                  }
               ]
            },
            {
               "target_column":"assembly_instruction_file_path",
               "source":"pdf_file_details",
               "source_column":"pdf_file_path"
            },
            {
               "target_column":"product_category",
               "source":"pdf_file_details",
               "source_column":"product_category"
            },
            {
               "target_column":"instruction_type",
               "source":"pdf_file_details",
               "source_column":"pdf_type"
            },
            {
               "target_column":"assembly_instruction_filename",
               "source":"pdf_file_details",
               "source_column":"pdf_file_name",
               "transform":[
                  {
                     "name":"replace_str",
                     "args":{
                        "str_to_replace":".pdf",
                        "replace_with":""
                     }
                  }
               ]
            },
            {
               "target_column":"assembly_manual_id",
               "source":"pdf_file_details",
               "source_column":"pdf_file_name",
               "transform":[
                  {
                     "name":"split_str",
                     "args":{
                        "delimiter":"__",
                        "index":1
                     }
                  },
                  {
                     "name":"replace_str",
                     "args":{
                        "str_to_replace":".pdf",
                        "replace_with":""
                     }
                  }
               ]
            }
         ],
         "secondary_sources":[
            {
               "secondary_source_key":"Product Details",
               "secondary_source":"product_details_arr",
               "key_field":"header",
               "value_field":"text",
               "exclude_keys":[
                  "Assembly instructions",
                  "Advice and care instructions"
               ]
            }
         ]
      },
      {
         "node_key":"instruction_manual_node",
         "strategy_type":"single_record",
         "primary_source_key":"PDF File Details",
         "primary_source":"pdf_file_detail",
         "primary_filter":{
            "field":"pdf_type",
            "ops":"contains",
            "value":"Assembly"
         },
         "fields":[
            {
               "target_column":"manual_id",
               "source":"pdf_file_details",
               "source_column":"pdf_file_name",
               "transform":[
                  {
                     "name":"split_str",
                     "args":{
                        "delimiter":"__",
                        "index":1
                     }
                  },
                  {
                     "name":"replace_str",
                     "args":{
                        "str_to_replace":".pdf",
                        "replace_with":""
                     }
                  }
               ]
            },
            {
               "target_column":"product_name",
               "source":"pdf_file_details",
               "source_column":"product_name",
               "transform":[
                  {
                     "name":"split_str",
                     "args":{
                        "delimiter":",",
                        "index":0
                     }
                  }
               ]
            },
            {
               "target_column":"manual_file_path",
               "source":"pdf_file_details",
               "source_column":"pdf_file_path"
            },
            {
               "target_column":"manual_file_name",
               "source":"pdf_file_details",
               "source_column":"pdf_file_name",
               "transform":[
                  {
                     "name":"replace_str",
                     "args":{
                        "str_to_replace":".pdf",
                        "replace_with":""
                     }
                  }
               ]
            },
            {
               "target_column":"manual_type",
               "source":"pdf_file_details",
               "source_column":"pdf_type"
            }
         ]
      },
      {
         "node_key":"markdown_file_chunk_node",
         "strategy_type":"file_walk",
         "primary_source_key":"PDF File Details",
         "primary_source":"pdf_file_detail",
         "primary_filter":{
            "field":"pdf_type",
            "ops":"contains",
            "value":"Assembly"
         },
         "source_files":{
            "base_path_settings":"datasource_config.markdown_files_path",
            "sub_folder_from_field":"pdf_file_path",
            "sub_folder_transform":[
               {
                  "name":"basename"
               },
               {
                  "name":"replace_str",
                  "args":{
                     "str_to_replace":".pdf",
                     "replace_with":""
                  }
               }
            ],
            "source_files_transform":[
               {
                  "name":"glob",
                  "args":{
                     "files_pattern":"*.md",
                     "recursive":true
                  }
               }
            ]
         },
         "fields":[
            {
               "target_column":"manual_id",
               "source":"pdf_file_details",
               "source_column":"pdf_file_name",
               "transform":[
                  {
                     "name":"split_str",
                     "args":{
                        "delimiter":"__",
                        "index":1
                     }
                  },
                  {
                     "name":"replace_str",
                     "args":{
                        "str_to_replace":".pdf",
                        "replace_with":""
                     }
                  }
               ]
            },
            {
               "target_column":"pdf_file_name",
               "source":"pdf_file_details",
               "source_column":"pdf_file_name",
               "transform":[
                  {
                     "name":"replace_str",
                     "args":{
                        "str_to_replace":".pdf",
                        "replace_with":""
                     }
                  }
               ]
            },
            {
               "target_column":"markdown_chunk_file_path",
               "source":"_file.path",
               "transform":[
                  {
                     "name":"file_absolute_path"
                  },
                  {
                     "name":"file_path_str"
                  }
               ]
            },
            {
               "target_column":"markdown_file_name",
               "source":"_file.name",
               "transform":[
                  {
                     "name":"file_name_op"
                  },
                  {
                     "name":"replace_str",
                     "args":{
                        "str_to_replace":".md",
                        "replace_with":""
                     }
                  }
               ]
            },
            {
               "target_column":"markdown_file_start_page",
               "source":"_file.name",
               "transform":[
                  {
                     "name":"file_name_op"
                  },
                  {
                     "name":"replace_str",
                     "args":{
                        "str_to_replace":".md",
                        "replace_with":""
                     }
                  },
                  {
                     "name":"split_str",
                     "args":{
                        "delimiter":"__",
                        "index":1
                     }
                  },
                  {
                     "name":"split_str",
                     "args":{
                        "delimiter":"_",
                        "index":-2
                     }
                  }
               ]
            },
            {
               "target_column":"markdown_file_end_page",
               "source":"_file.name",
               "transform":[
                  {
                     "name":"file_name_op"
                  },
                  {
                     "name":"replace_str",
                     "args":{
                        "str_to_replace":".md",
                        "replace_with":""
                     }
                  },
                  {
                     "name":"split_str",
                     "args":{
                        "delimiter":"__",
                        "index":1
                     }
                  },
                  {
                     "name":"split_str",
                     "args":{
                        "delimiter":"_",
                        "index":-1
                     }
                  }
               ]
            }
         ]
      },
      {
         "node_key":"chunk_nodes",
         "strategy_type":"file_chunking_and_parse",
         "primary_source_key":"PDF File Details",
         "primary_source":"pdf_file_detail",
         "primary_filter":{
            "field":"pdf_type",
            "ops":"contains",
            "value":"Assembly"
         },
         "source_files":{
            "base_path_settings":"datasource_config.markdown_files_path",
            "source_file_extension":".md",
            "sub_folder_from_field":"pdf_file_path",
            "sub_folder_transform":[
               {
                  "name":"basename"
               },
               {
                  "name":"replace_str",
                  "args":{
                     "str_to_replace":".pdf",
                     "replace_with":""
                  }
               }
            ],
            "source_files_transform":[
               {
                  "name":"glob",
                  "args":{
                     "files_pattern":"*.md",
                     "recursive":true
                  }
               }
            ]
         },
         "chunk_file_config":{
            "file_format":"markdown",
            "page_sections_pattern":"<!-- Page Break -->",
            "header_split_pattern":"\\n\\n(?=[^\\n]+\\n\\n##)",
            "sub_parts_pattern":"(!\\[Image\\].*?\\))",
            "chunk_type_conditions":[
               {
                  "type":"image",
                  "condition":"startswith",
                  "cond_value":"![Image]"
               },
               {
                  "type":"language_warning_text",
                  "condition":"regex_match",
                  "cond_value":"^[^\\n]+\\n\\n##"
               },
               {
                  "type":"text",
                  "condition":"default"
               }
            ]
         },
         "sub_group_chunk_config":{
            "image_nodes_arr":{
               "primary_source":"_context.chunk",
               "chunk_type":"image",
               "fields":[
                  {
                     "target_column":"pdf_file_name",
                     "source":"_context.record",
                     "source_column":"pdf_file_name",
                     "transform":[
                        {
                           "name":"replace_str",
                           "args":{
                              "str_to_replace":".pdf",
                              "replace_with":""
                           }
                        }
                     ]
                  },
                  {
                     "target_column":"markdown_file_name",
                     "source":"_context.file_name",
                     "transform":[
                        {
                           "name":"replace_str",
                           "args":{
                              "str_to_replace":".md",
                              "replace_with":""
                           }
                        }
                     ]
                  },
                  {
                     "target_column":"page_number",
                     "source":"_context.chunk",
                     "source_column":"page",
                     "transform":[
                        {
                           "name":"page_number_offset",
                           "args":{
                              "file_start_page":"_context.file_start_page",
                              "offset":1
                           }
                        }
                     ]
                  },
                  {
                     "target_column":"image_id",
                     "source":"_context.chunk",
                     "source_column":"content",
                     "transform":[
                        {
                           "name":"split_str",
                           "args":{
                              "delimiter":"/",
                              "index":-1
                           }
                        },
                        {
                           "name":"replace_str",
                           "args":{
                              "str_to_replace":".png",
                              "replace_with":""
                           }
                        },
                        {
                           "name":"split_join",
                           "args":{
                              "delimiter":"_",
                              "index":[
                                 0,
                                 1
                              ],
                              "join_with":"_"
                           }
                        }
                     ]
                  },
                  {
                     "target_column":"image_path",
                     "source":"_context.chunk",
                     "source_column":"content",
                     "transform":[
                        {
                           "name":"replace_str",
                           "args":{
                              "str_to_replace":"![Image]",
                              "replace_with":""
                           }
                        },
                        {
                           "name":"replace_str",
                           "args":{
                              "str_to_replace":"(",
                              "replace_with":""
                           }
                        },
                        {
                           "name":"replace_str",
                           "args":{
                              "str_to_replace":")",
                              "replace_with":""
                           }
                        }
                     ]
                  },
                  {
                     "target_column":"content",
                     "source":"_context.chunk",
                     "source_column":"content"
                  },
                  {
                     "target_column":"image_hex_name",
                     "source":"_context.chunk",
                     "source_column":"content",
                     "transform":[
                        {
                           "name":"split_str",
                           "args":{
                              "delimiter":"/",
                              "index":-1
                           }
                        },
                        {
                           "name":"replace_str",
                           "args":{
                              "str_to_replace":".png",
                              "replace_with":""
                           }
                        },
                        {
                           "name":"replace_str",
                           "args":{
                              "str_to_replace":")",
                              "replace_with":""
                           }
                        },
                        {
                           "name":"replace_str",
                           "args":{
                              "str_to_replace":"(",
                              "replace_with":""
                           }
                        },
                        {
                           "name":"split_str",
                           "args":{
                              "delimiter":"_",
                              "index":-1
                           }
                        }
                     ]
                  },
                  {
                     "target_column":"type",
                     "source":"_context.chunk",
                     "source_column":"type"
                  }
               ]
            },
            "text_nodes_arr":{
               "primary_source":"_context.chunk",
               "chunk_type":"text",
               "fields":[
                  {
                     "target_column":"pdf_file_name",
                     "source":"_context.record",
                     "source_column":"pdf_file_name",
                     "transform":[
                        {
                           "name":"replace_str",
                           "args":{
                              "str_to_replace":".pdf",
                              "replace_with":""
                           }
                        }
                     ]
                  },
                  {
                     "target_column":"markdown_file_name",
                     "source":"_context.file_name",
                     "transform":[
                        {
                           "name":"replace_str",
                           "args":{
                              "str_to_replace":".md",
                              "replace_with":""
                           }
                        }
                     ]
                  },
                  {
                     "target_column":"page_number",
                     "source":"_context.chunk",
                     "source_column":"page",
                     "transform":[
                        {
                           "name":"page_number_offset",
                           "args":{
                              "file_start_page":"_context.file_start_page",
                              "offset":1
                           }
                        }
                     ]
                  },
                  {
                     "target_column":"content",
                     "source":"_context.chunk",
                     "source_column":"content"
                  },
                  {
                     "target_column":"type",
                     "source":"_context.chunk",
                     "source_column":"type"
                  }
               ]
            },
            "language_warning_text_nodes_arr":{
               "primary_source_key":"_context.chunk",
               "chunk_type":"language_warning_text",
               "lookahead_type_content_cfg":{
                  "chunk_column":"content",
                  "condition_column":"type",
                  "type_conditions":[
                     "language_warning_text",
                     "image",
                     "text"
                  ],
                  "merge_content_index":2
               },
               "fields":[
                  {
                     "target_column":"pdf_file_name",
                     "source":"_context.record",
                     "source_column":"pdf_file_name",
                     "transform":[
                        {
                           "name":"replace_str",
                           "args":{
                              "str_to_replace":".pdf",
                              "replace_with":""
                           }
                        }
                     ]
                  },
                  {
                     "target_column":"markdown_file_name",
                     "source":"_context.file_name",
                     "transform":[
                        {
                           "name":"replace_str",
                           "args":{
                              "str_to_replace":".md",
                              "replace_with":""
                           }
                        }
                     ]
                  },
                  {
                     "target_column":"page_number",
                     "source":"_context.chunk",
                     "source_column":"page",
                     "transform":[
                        {
                           "name":"page_number_offset",
                           "args":{
                              "file_start_page":"_context.file_start_page",
                              "offset":1
                           }
                        }
                     ]
                  },
                  {
                     "target_column":"language_warning",
                     "source":"_context.chunk",
                     "source_column":"content",
                     "transform":[
                        {
                           "name":"split_str",
                           "args":{
                              "delimiter":"\n\n##",
                              "index":0
                           }
                        }
                     ]
                  },
                  {
                     "target_column":"content",
                     "source":"_context.chunk",
                     "source_column":"content",
                     "transform":[
                        {
                           "name":"split_str",
                           "args":{
                              "delimiter":"\n\n##",
                              "index":1
                           }
                        }
                     ]
                  },
                  {
                     "target_column":"type",
                     "source":"_context.chunk",
                     "source_column":"type"
                  }
               ]
            }
         }
      },
      {
         "node_key":"image_json_node_arr",
         "strategy_type":"image_json_file_parsing",
         "primary_source_key":"PDF File Details",
         "primary_source":"pdf_file_detail",
         "primary_filter":{
            "field":"pdf_type",
            "ops":"contains",
            "value":"Assembly"
         },
         "source_files":{
            "base_path_settings":"datasource_config.markdown_files_path",
            "source_file_extension":".json",
            "sub_folder_from_field":"pdf_file_path",
            "sub_folder_transform":[
               {
                  "name":"basename"
               },
               {
                  "name":"replace_str",
                  "args":{
                     "str_to_replace":".pdf",
                     "replace_with":""
                  }
               }
            ],
            "source_files_transform":[
               {
                  "name":"glob",
                  "args":{
                     "files_pattern":"*.json",
                     "recursive":true
                  }
               }
            ]
         },
         "parse_file_config":{
            "file_mode":"r",
            "file_encoding":"utf-8",
            "fallback_extraction":{
               "json_start_char":"{",
               "json_end_char":"}"
            }
         },
         "file_schema_validation":{
            "main_field":"classification",
            "field_validation":{
               "assembly":[
                  "classification",
                  "step_name",
                  "action",
                  "parts",
                  "tools",
                  "difficulty"
               ],
               "guidance":[
                  "classification",
                  "content_type",
                  "description",
                  "key_info",
                  "guidance"
               ]
            },
            "special_check":{
               "assembly":[
                  "safety",
                  "safety_alert"
               ]
            }
         },
         "common_fields":[
            {
               "target_column":"pdf_file_name",
               "source":"_context.record",
               "source_column":"pdf_file_name",
               "transform":[
                  {
                     "name":"replace_str",
                     "args":{
                        "str_to_replace":".pdf",
                        "replace_with":""
                     }
                  }
               ]
            },
            {
               "target_column":"markdown_file_name",
               "source":"_context.file_path",
               "transform":[
                  {
                     "name":"parent_folder_name"
                  }
               ]
            },
            {
               "target_column":"image_id",
               "source":"_context.file_name",
               "transform":[
                  {
                     "name":"file_stem_op"
                  }
               ]
            },
            {
               "target_column":"classification",
               "source":"_context.file_data",
               "source_column":"classification"
            }
         ],
         "conditional_mapping":{
            "descriminator_field":"classification",
            "field_branches":{
               "assembly":{
                  "fields":[
                     {
                        "target_column":"step_name",
                        "source":"_context.file_data",
                        "source_column":"step_name"
                     },
                     {
                        "target_column":"action",
                        "source":"_context.file_data",
                        "source_column":"action"
                     },
                     {
                        "target_column":"parts",
                        "source":"_context.file_data",
                        "source_column":"parts"
                     },
                     {
                        "target_column":"tools",
                        "source":"_context.file_data",
                        "source_column":"tools"
                     },
                     {
                        "target_column":"tools_str",
                        "source":"_context.file_data",
                        "source_column":"tools",
                        "transform":[
                           {
                              "name":"join_list_to_str",
                              "args":{
                                 "delimiter":", "
                              }
                           }
                        ]
                     },
                     {
                        "target_column":"safety",
                        "source":"_context.file_data",
                        "source_column":"safety or safety_alert"
                     },
                     {
                        "target_column":"difficulty",
                        "source":"_context.file_data",
                        "source_column":"difficulty"
                     },
                     {
                        "target_column":"difficulty_str",
                        "source":"_context.file_data",
                        "source_column":"difficulty",
                        "transform":[
                           {
                              "name":"join_list_to_str",
                              "args":{
                                 "delimiter":", "
                              }
                           }
                        ]
                     }
                  ]
               },
               "guidance":{
                  "fields":[
                     {
                        "target_column":"content_type",
                        "source":"_context.file_data",
                        "source_column":"content_type"
                     },
                     {
                        "target_column":"description",
                        "source":"_context.file_data",
                        "source_column":"description"
                     },
                     {
                        "target_column":"key_info",
                        "source":"_context.file_data",
                        "source_column":"key_info"
                     },
                     {
                        "target_column":"key_info_str",
                        "source":"_context.file_data",
                        "source_column":"key_info",
                        "transform":[
                           {
                              "name":"enumerate_join_to_str",
                              "args":{
                                 "delimiter":", "
                              }
                           }
                        ]
                     },
                     {
                        "target_column":"guidance",
                        "source":"_context.file_data",
                        "source_column":"guidance"
                     }
                  ]
               }
            }
         }
      }
   ]
}
