630aa0feb238858dff79d1c620e2ef7a3fb8b4ab6a88deec41dd9e1761.png)', 'content': {'classification': 'Assembly', 'step_name': 'Mount Screws', 'action': '1. Align screw ↓\n2. Insert ↓\n3. Tighten ✓', 'parts': [{'id': '151705', 'name': 'screw', 'quantity': 18}, {'id': '151706', 'name': 'screw', 'quantity': 18}], 'tools': [], 'safety': 'Tip-over hazard – Secure to wall – tip-over hazard', 'difficulty': ['Easy']}, 'type': 'image', 'image_id': '3487be630aa0feb238858dff79d1c620e2ef7a3fb8b4ab6a88deec41dd9e1761'}, {'chunk_id': 'billy-bookcase-black-oak-effect__AA-2545155-1-100_chunk_92', 'page_number': 13, 'assembly_instruction_file_name': 'billy-bookcase-black-oak-effect__AA-2545155-1-100', 'image_file_path': '![Image](/home/anu/RAG_AI_ML_Projects/IKEA_Assembly_Instruction_Processing/data/markdown_files/billy-bookcase-black-oak-effect__AA-2545155-1-100/billy-bookcase-black-oak-effect__AA-2545155-1-100_11_15_artifacts/image_000003_b9297b775bff30ed5ff61c6b9b540945fb684af88dda4b06f087ac710267f235.png)', 'content': {'classification': 'Assembly', 'step_name': 'Slide door panel down', 'action': '1. Pull back arrow ↓ to slide panel down\n2. Align front edge ↻ with wall\n3. Tighten fastener ✓', 'parts': [{'id': '104325', 'name': 'screw', 'quantity': 6}], 'tools': [], 'safety': 'Falling hazard – anchor required', 'difficulty': ['Medium']}, 'type': 'image', 'image_id': 'b9297b775bff30ed5ff61c6b9b540945fb684af88dda4b06f087ac710267f235'}, {'chunk_id': 'billy-bookcase-black-oak-effect__AA-2545155-1-100_chunk_93', 'page_number': 13, 'assembly_instruction_file_name': 'billy-bookcase-black-oak-effect__AA-2545155-1-100', 'image_file_path': '![Image](/home/anu/RAG_AI_ML_Projects/IKEA_Assembly_Instruction_Processing/data/markdown_files/billy-bookcase-black-oak-effect__AA-2545155-1-100/billy-bookcase-black-oak-effect__AA-2545155-1-100_11_15_artifacts/image_000004_c85b60220ba13a81f2325d14750f8bc0da3406b547316e91a499c951e2916661.png)', 'content': '![Image](/home/anu/RAG_AI_ML_Projects/IKEA_Assembly_